{
  "name": "hyperstudio-workspace",
  "version": "0.2.0",
  "description": "Creative IR, deterministic compiler and cinematic recipes on top of HyperFrames",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "hyperstudio": "node packages/cli/src/cli.ts",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"packages/*/src/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "skill:link": "mkdir -p .claude/skills && ln -sfn ../../skills/hyperstudio-director .claude/skills/hyperstudio-director",
    "prepare": "husky",
    "test:unit": "node --test \"packages/*/src/**/*.test.ts\"",
    "test:integration": "node --test \"tests/integration/*.test.ts\"",
    "test:regression": "node --test \"tests/regression/*.test.ts\"",
    "test:update": "UPDATE_GOLDEN=1 node --test \"tests/regression/*.test.ts\"",
    "test:e2e": "HYPERSTUDIO_E2E=1 node --test \"tests/integration/*.e2e.test.ts\"",
    "deps:update": "pnpm dlx npm-check-updates -u --workspaces --root && pnpm install && pnpm verify"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FjrREPO/hyperstudio.git"
  }
}
