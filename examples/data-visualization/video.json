{
  "project": {
    "title": "Velo 2026 - Data Visualization",
    "fps": 30,
    "aspectRatio": "16:9",
    "duration": 18.4
  },
  "style": {
    "background": "#07100d",
    "ink": "#f1f7f3",
    "accent": "#34d399",
    "headingFont": "Outfit",
    "bodyFont": "Outfit"
  },
  "scenes": [
    {
      "id": "intro",
      "recipe": "kinetic-typography",
      "duration": 3.6,
      "text": {
        "line1": "One city.",
        "line2": "One year.",
        "line3": "On two wheels.",
        "emphasis": "two wheels."
      },
      "params": {
        "mode": "stack",
        "motion": "rise",
        "backdrop": "glow"
      }
    },
    {
      "id": "rides",
      "recipe": "data-storytelling",
      "duration": 5.5,
      "text": {
        "eyebrow": "Rides",
        "statSuffix": "M",
        "statLabel": "trips taken in 2026",
        "headline": "Up from 1.9 million two years ago.",
        "bars": "2023:1.2, 2024:1.9, 2025:3.4, 2026:4.8",
        "barSuffix": "M"
      },
      "params": {
        "stat": 4.8,
        "decimals": 1,
        "layout": "split"
      },
      "transition": {
        "type": "crossfade",
        "duration": 0.5
      }
    },
    {
      "id": "docks",
      "recipe": "data-storytelling",
      "duration": 5.5,
      "text": {
        "eyebrow": "Busiest docks",
        "statLabel": "stations across the city",
        "bars": "Central:9.2, Harbor:7.8, Old Town:6.1, University:5.4, Stadium:3.9",
        "barSuffix": "k",
        "highlight": "Central"
      },
      "params": {
        "stat": 312,
        "layout": "stacked",
        "accent": "#fbbf24"
      },
      "transition": {
        "type": "crossfade",
        "duration": 0.5
      }
    },
    {
      "id": "impact",
      "recipe": "data-storytelling",
      "duration": 4.8,
      "text": {
        "statSuffix": " t",
        "statLabel": "of carbon dioxide not emitted",
        "headline": "Like 460 cars off the road for a year."
      },
      "params": {
        "stat": 2140,
        "exit": "fade"
      },
      "transition": {
        "type": "fade",
        "duration": 0.6
      }
    }
  ],
  "audio": [
    {
      "id": "bed",
      "src": "assets/bed.m4a",
      "volume": 0.8,
      "fadeIn": 1,
      "fadeOut": 2
    }
  ]
}
