{
  "project": {
    "title": "Lumen - SaaS Product Launch",
    "fps": 30,
    "aspectRatio": "16:9",
    "duration": 23
  },
  "style": {
    "accent": "#6d5efc",
    "accent2": "#22d3ee",
    "background": "#0a0b14",
    "ink": "#f5f6fb",
