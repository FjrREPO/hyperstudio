    "bodyFont": "Inter"
  },
  "scenes": [
    {
      "id": "hook",
      "recipe": "kinetic-typography",
      "duration": 4.8,
      "text": {
        "line1": "Monday, 9 a.m.",
        "line2": "Nine tabs open.",
        "line3": "One question.",
        "emphasis": "One question."
      },
      "params": {
        "mode": "sequence",
        "motion": "slam",
        "backdrop": "grid"
      }
    },
    {
      "id": "reveal",
      "recipe": "tech-product-launch",
      "duration": 5.5,
      "assets": {
        "screen": "assets/lumen-dashboard.svg"
      },
      "text": {
        "eyebrow": "Introducing Lumen",
        "headline": "Revenue you can read.",
        "subline": "Every metric your team argues about, in one live view.",
        "chip1": "Live MRR",
        "chip2": "Cohorts",
        "chip3": "Alerts",
        "url": "app.lumen.example"
      },
      "params": {
        "layout": "center",
        "camera": "tilt-rise"
      },
      "transition": {
        "type": "crossfade",
        "duration": 0.5
      }
    },
    {
      "id": "proof",
      "recipe": "data-storytelling",
      "duration": 5,
      "text": {
        "eyebrow": "After 90 days",
        "statSuffix": "%",
        "statLabel": "more questions answered without an analyst",
        "headline": "Teams stop waiting for a report and look for themselves.",
        "bars": "Week 1:38, Week 4:96, Week 8:155, Week 12:214",
        "barSuffix": "%"
      },
      "params": {
        "stat": 214,
        "layout": "split",
        "accent": "#22d3ee"
      },
      "transition": {
        "type": "crossfade",
        "duration": 0.5
      }
    },
    {
      "id": "share",
      "recipe": "tech-product-launch",
      "duration": 4.5,
      "assets": {
        "screen": "assets/lumen-dashboard.svg"
      },
      "text": {
        "eyebrow": "Dashboards",
        "headline": "Built for the Monday meeting.",
        "subline": "Share a link, not a spreadsheet.",
        "chip1": "One click",
        "chip2": "No SQL"
      },
      "params": {
        "layout": "right",
        "camera": "sweep",
        "frame": "bare"
      },
      "transition": {
        "type": "fade",
        "duration": 0.6
      }
    },
    {
      "id": "close",
      "recipe": "kinetic-typography",
      "duration": 4.2,
      "text": {
        "line1": "Lumen.",
        "line2": "Start free today.",
        "emphasis": "Lumen."
      },
      "params": {
        "mode": "stack",
        "motion": "rise",
        "backdrop": "glow",
        "exit": "fade"
      },
      "transition": {
        "type": "fade",
        "duration": 0.6
      }
    }
  ],
  "audio": [
    {
      "id": "bed",
      "src": "assets/bed.m4a",
      "volume": 0.8,
      "fadeIn": 1,
      "fadeOut": 2
    }
  ]
