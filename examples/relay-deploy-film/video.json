        {
          "at": 11.2,
          "do": "camera",
          "target": "window",
          "fill": 0.94,
          "over": 1.4,
          "ease": "none"
        }
      ]
    },
    {
      "id": "close",
      "recipe": "brand-close",
      "duration": 2.8,
      "purpose": "The name arrives only after the release is live, with the one promise the film has just shown.",
