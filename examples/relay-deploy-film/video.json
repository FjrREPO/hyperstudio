          "over": 0.7
        },
        {
          "at": 7.6,
          "do": "click",
          "target": "promote",
          "state": "live",
          "over": 0.3
        },
        {
          "at": 7.7,
          "do": "reveal",
          "target": "wave-3",
          "over": 1.8
        },
        {
          "at": 7.8,
          "do": "camera",
          "target": "fleet",
          "fill": 0.98,
          "tilt": "up",
          "over": 1.9
        },
        {
          "at": 9.9,
          "do": "camera",
          "target": "window",
          "fill": 1,
          "tilt": "none",
          "over": 1.2
        },
        {
          "at": 10.3,
          "do": "highlight",
          "target": "status",
          "over": 1.6
