{
  "project": {
    "title": "Relay - launch film",
    "fps": 30,
    "aspectRatio": "16:9",
    "duration": 28.0
  },
  "direction": {
    "concept": "One line of code travels from an editor to every machine in production, and each stop on the way is a different picture.",
    "audience": "Engineers who ship several times a day and have been burned by a deploy that went everywhere at once.",
    "message": "Relay moves a release across your fleet in steps you can watch, and it is live when the last machine turns.",
    "tone": "Terse and precise, like good tooling; nothing is explained twice and nothing is decorated.",
    "palette": "The product's own near-black is the whole frame; amber marks what is being changed, green is the new release, and the fleet turning green is the film's one colour event.",
    "typography": "None of the film's own until the name at the end: every word before it is code, a log or the product, in its monospace, set large enough to read.",
    "motion": "What moves is the deploy itself, a line typed, a bar filling, shards finishing, machines turning; the camera only steps back to show how far it has got.",
    "pacing": "Four milestones of about six seconds, each cut on its completion, with the longest hold on the fleet fully turned before the name."
  },
  "brand": {
    "name": "Relay",
    "kind": "example",
    "url": "relay.example"
  },
  "style": {
    "background": "#040506",
    "ink": "#e6edf3",
    "accent": "#3ddc97",
    "displayFont": "Inter",
    "textFont": "IBM Plex Mono",
    "light": "none"
  },
  "screens": {
    "change": {
      "html": "product/change.html",
      "width": 1440,
      "height": 900,
      "origin": "placeholder"
    },
    "build": {
      "html": "product/build.html",
      "width": 1440,
      "height": 900,
      "origin": "placeholder"
    },
    "rollout": {
      "html": "product/rollout.html",
      "width": 1440,
      "height": 900,
      "origin": "placeholder"
    }
  },
  "scenes": [
    {
      "id": "change",
      "recipe": "product-take",
      "duration": 6.4,
      "screen": "change",
      "purpose": "The journey starts with the smallest possible thing: one line rewritten in an editor, then pushed.",
      "params": {
        "chrome": "none",
        "radius": 10,
        "maxZoom": 2.6,
        "tilt": "none",
        "spill": true,
        "from": "edit",
        "fill": 0.96
      },
      "beats": [
        {
          "at": 0.2,
          "do": "camera",
          "target": "edit",
          "fill": 0.9,
          "over": 2.0,
          "ease": "none"
        },
        {
          "at": 0.3,
          "do": "type",
          "target": "edit",
          "text": "    const delay = backoff(attempt, { cap: 8_000 });",
          "over": 1.9
        },
        {
          "at": 2.4,
          "do": "state",
          "state": "changed"
        },
        {
          "at": 2.5,
          "do": "camera",
          "target": "window",
          "fill": 1,
          "over": 1.1
        },
        {
          "at": 3.8,
          "do": "camera",
          "target": "terminal",
          "fill": 0.9,
          "level": "bleed",
          "over": 1.2
        },
        {
          "at": 4.0,
          "do": "type",
          "target": "prompt-input",
          "text": "git push origin main",
          "over": 1.1
        },
        {
          "at": 5.3,
          "do": "state",
          "state": "pushed"
        },
        {
          "at": 5.3,
          "do": "reveal",
          "target": "pushed",
          "over": 0.5
        },
        {
          "at": 5.3,
          "do": "camera",
          "target": "terminal",
          "fill": 0.96,
          "over": 1.1,
          "ease": "none"
        }
      ]
    },
    {
      "id": "build",
      "recipe": "product-take",
      "duration": 6.2,
      "screen": "build",
      "purpose": "The second milestone is the machine's work: the build completes and six shards of tests finish.",
      "params": {
        "chrome": "none",
        "radius": 10,
        "maxZoom": 2.6,
        "tilt": "none",
        "spill": true,
        "from": "window",
        "fill": 1
      },
      "beats": [
        {
          "at": 0.2,
          "do": "reveal",
          "target": "build",
          "over": 1.7
        },
        {
          "at": 0.2,
          "do": "camera",
          "target": "window",
          "fill": 1,
          "over": 2.0,
          "ease": "none"
        },
        {
          "at": 0.5,
          "do": "draw",
          "target": "build-bar",
          "over": 1.7
        },
        {
          "at": 2.3,
          "do": "state",
          "state": "testing"
        },
        {
          "at": 2.4,
          "do": "camera",
          "target": "tests",
          "fill": 0.94,
          "over": 0.9
        },
        {
          "at": 2.6,
          "do": "draw",
          "target": "shards",
          "over": 2.0
        },
        {
          "at": 4.8,
          "do": "state",
          "state": "passed"
        },
        {
          "at": 4.8,
          "do": "reveal",
          "target": "result",
          "over": 0.4
        },
        {
          "at": 4.9,
          "do": "camera",
          "target": "window",
          "fill": 1,
          "over": 1.3
        }
      ]
    },
    {
      "id": "rollout",
      "recipe": "product-take",
      "duration": 12.6,
      "screen": "rollout",
      "purpose": "The release moves across thirty machines in three waves, and the last wave is the payoff: live everywhere.",
      "params": {
        "chrome": "none",
        "radius": 10,
        "maxZoom": 2.6,
        "tilt": "left",
        "spill": true,
        "from": "fleet",
        "fill": 0.9,
        "lens": "wide"
      },
      "beats": [
        {
          "at": 0.2,
          "do": "camera",
          "target": "fleet",
          "fill": 0.9,
          "tilt": "left",
          "over": 1.6,
          "ease": "none"
        },
        {
          "at": 0.3,
          "do": "reveal",
          "target": "wave-1",
          "over": 0.8
        },
        {
          "at": 1.9,
          "do": "camera",
          "target": "traffic",
          "fill": 0.62,
          "tilt": "none",
          "over": 0.9
        },
        {
