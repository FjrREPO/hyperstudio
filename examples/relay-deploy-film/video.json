{
  "project": {
    "title": "Relay - launch film",
    "fps": 30,
    "aspectRatio": "16:9",
    "duration": 29.1
  },
  "direction": {
    "concept": "Thirty machines are running the product; one line of code changes, and the film follows it until every machine has it.",
    "audience": "Engineers who ship several times a day and have been burned by a deploy that went everywhere at once.",
    "message": "Relay moves a release across your fleet in steps you can watch, and it is live when the last machine turns.",
    "tone": "Terse and precise, like good tooling; nothing is explained twice and nothing is decorated.",
    "palette": "The product's own near-black is the whole frame; amber marks what is being changed, green is the new release, and the fleet turning green is the film's one colour event.",
    "typography": "None of the film's own until the name at the end: every word before it is code, a log or the product, in its monospace, set large enough to read.",
    "motion": "What moves is the deploy itself, a line typed, a bar filling, shards finishing, machines turning; the camera only steps back to show how far it has got.",
    "pacing": "A short look at what is at stake, then four milestones cut on their completion, the last wave given the longest run, and the name arriving out of one green machine."
  },
  "brand": {
    "name": "Relay",
    "kind": "example",
    "url": "relay.example"
  },
  "style": {
    "background": "#040506",
    "ink": "#e6edf3",
    "accent": "#3ddc97",
    "displayFont": "Inter",
    "textFont": "IBM Plex Mono",
    "light": "none"
  },
