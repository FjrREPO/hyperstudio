{
  "project": {
    "title": "Marlow - 17.7 second launch film",
    "fps": 30,
    "aspectRatio": "16:9",
    "duration": 17.7
  },
  "direction": {
    "concept": "The film follows one meeting from the confusion after it to notes that name who does what.",
    "audience": "Team leads who leave meetings unsure what was decided and end up writing the follow-up themselves.",
    "message": "Marlow turns a meeting into decisions and owners, and sends them to the people named.",
    "tone": "Warm and editorial, like a well-set page; the product is calm and the film does not hurry it.",
    "palette": "Warm paper stage with a green and an amber glow, ink for type, and one green accent that marks what is decided or done.",
    "typography": "Playfair Display for the film's own lines, so the brand speaks in a different voice from its Inter interface.",
    "motion": "One camera move per shot; the opening wide shot lies on a desk in shallow focus, close shots are flat or turned slightly.",
    "pacing": "Ten shots, cut on each click; state changes get their own shot so the viewer sees cause and effect."
  },
  "brand": {
    "name": "Marlow",
    "kind": "example",
    "url": "marlow.example"
  },
  "style": {
    "background": "#efe8da",
    "ink": "#1b1814",
    "accent": "#0e7a53",
    "glow": "#e79a4c",
    "displayFont": "Playfair Display",
    "textFont": "Inter",
    "light": "aurora"
  },
