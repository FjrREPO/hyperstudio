  "scenes": [
    {
      "id": "problem",
      "recipe": "scatter",
      "duration": 2.6,
      "purpose": "Open on the minutes after a meeting, when nobody is sure what was decided or who owns it.",
      "text": {
        "note1": "Wait, who owns this?",
        "note2": "What did we decide?",
        "note3": "Who took notes?",
        "note4": "Let me find the recording",
        "line": "The meeting ended. Now what?"
      }
    },
    {
      "id": "reveal",
      "recipe": "product-shot",
      "duration": 2.2,
      "purpose": "Show the product holding the whole meeting, and ask it to write the notes.",
      "screen": "meeting",
      "params": {
        "from": "window",
        "fill": 0.9,
        "tilt": "desk",
        "focus": "band",
        "cursor": "summarise-button",
        "clickAt": 0.74
      }
    },
    {
      "id": "meet",
      "recipe": "statement",
      "duration": 1.2,
      "purpose": "Name the product the viewer has just watched being used.",
      "text": {
        "line1": "Meet Marlow.",
        "emphasis": "Marlow."
      },
      "params": {
        "size": "display"
      }
    },
    {
      "id": "notes",
      "recipe": "product-shot",
      "duration": 1.9,
      "purpose": "The click produced the notes: one headline and what was decided.",
      "screen": "summary",
      "params": {
        "from": "window",
        "to": "decisions",
        "fill": 0.8,
        "move": "settle",
        "tilt": "left"
      }
    },
    {
      "id": "owners",
      "recipe": "product-shot",
      "duration": 1.6,
      "purpose": "Every action has a person; tick the first one off.",
      "screen": "summary",
      "params": {
        "isolate": "summary",
        "radius": 20,
        "from": "actions",
        "fill": 0.84,
        "cursor": "action-1-box",
        "clickAt": 0.62
      }
    },
    {
      "id": "ticked",
      "recipe": "product-shot",
      "duration": 1.2,
      "purpose": "The state changes: the action is done and stays on the record.",
      "screen": "done",
      "params": {
        "isolate": "summary",
        "radius": 20,
        "from": "actions",
        "to": "action-1",
        "highlight": "action-1",
        "fill": 0.8,
        "tilt": "right"
      }
    },
    {
      "id": "send",
      "recipe": "product-shot",
      "duration": 1.4,
      "purpose": "Send the notes to the people named in them.",
      "screen": "done",
      "params": {
        "from": "actions",
        "to": "send-button",
        "fill": 0.7,
        "move": "ease",
        "cursor": "send-button",
        "clickAt": 0.68
      }
    },
    {
      "id": "sent",
      "recipe": "product-shot",
      "duration": 1.2,
      "purpose": "It arrived: the team has the notes and each owner was told.",
      "screen": "sent",
      "params": {
        "from": "toast",
        "fill": 0.5,
        "tilt": "up"
      }
    },
    {
      "id": "benefit",
      "recipe": "statement",
      "duration": 1.8,
      "purpose": "Say what the product changes about meetings.",
      "text": {
        "line1": "Every meeting ends",
        "line2": "with who does what.",
        "emphasis": "who"
