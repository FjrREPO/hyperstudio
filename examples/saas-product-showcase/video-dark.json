{
  "project": {
    "title": "Lumen - cinematic cut",
    "fps": 30,
    "aspectRatio": "16:9",
    "duration": 16.7
  },
  "direction": {
    "concept": "The product is the only light in a dark room; the camera finds it leaning back, comes upright as it answers, and walks round it.",
    "audience": "People who run a subscription business and wait on someone else for every revenue number.",
    "message": "You can ask Lumen a revenue question in plain words and have the answer before the meeting.",
    "tone": "Quiet and confident, closer to a product photograph than a screen recording.",
    "palette": "A black stage lit only by the screen's own cobalt spill; type in warm white.",
    "typography": "Playfair Display, set over or beside the screen in the dark, never on top of the interface.",
    "motion": "The camera changes angle and focus as the product changes state: leaning and soft while the question is typed, upright and sharp when the answer lands, turned aside to make room for the line.",
    "pacing": "A slow push through the typing, a beat of stillness on the answer, a turn, and a long last move into the mark."
  },
  "brand": {
    "name": "Lumen",
    "kind": "example",
    "url": "lumen.example"
  },
  "style": {
    "background": "#07080b",
    "ink": "#f4f2ec",
    "accent": "#4f6bff",
    "displayFont": "Playfair Display",
    "textFont": "Inter",
    "light": "none"
  },
  "screens": {
    "app": {
      "html": "product/index.html",
      "width": 1440,
      "height": 900,
      "origin": "placeholder"
    }
  },
  "scenes": [
    {
      "id": "film",
      "recipe": "product-take",
      "duration": 16.7,
      "screen": "app",
      "purpose": "The whole film is one take: the product is used from question to shared answer, the film's lines sit beside it, and it resolves into its own mark.",
      "params": {
        "from": "window",
        "fill": 0.8,
        "tilt": "up",
        "focus": "near",
        "spill": true,
        "maxZoom": 5,
        "side": "right"
      },
      "beats": [
        {
          "at": 0.0,
          "do": "say",
          "text": "Every number\nused to be\na ticket.",
          "place": "left",
          "size": "hero",
          "over": 2.6
        },
        {
          "at": 2.3,
          "do": "camera",
          "target": "ask-bar",
          "fill": 0.78,
          "side": "centre",
          "over": 1.3
        },
        {
          "at": 2.7,
          "do": "cursor",
          "target": "ask-input",
          "over": 0.5
        },
        {
          "at": 2.9,
          "do": "type",
          "target": "ask-input",
          "text": "Which plan grew fastest last quarter?",
          "over": 1.4
        },
        {
          "at": 4.6,
          "do": "click",
          "target": "send",
          "state": "thinking",
          "over": 0.4
        },
        {
          "at": 4.7,
          "do": "camera",
          "target": "answer",
          "fill": 0.82,
          "tilt": "none",
          "focus": "all",
          "over": 1.2
        },
        {
          "at": 5.9,
          "do": "state",
          "state": "arriving"
        },
        {
          "at": 5.9,
          "do": "reveal",
          "target": "answer",
          "over": 1.0
        },
        {
          "at": 6.2,
          "do": "draw",
          "target": "plot",
          "over": 1.0
        },
        {
          "at": 6.4,
          "do": "count",
          "target": "team-value",
          "over": 0.9
        },
        {
          "at": 7.8,
          "do": "camera",
          "target": "answer",
          "fill": 0.9,
          "side": "left",
          "tilt": "left",
          "over": 1.2
        },
        {
          "at": 8.1,
          "do": "say",
          "text": "No ticket.\nNo waiting.",
          "place": "right",
          "size": "hero",
          "over": 2.3
        },
        {
          "at": 8.6,
          "do": "cursor",
          "target": "bar-team",
          "over": 0.6
        },
        {
          "at": 8.8,
          "do": "highlight",
          "target": "bar-team",
          "over": 1.4
        },
        {
          "at": 10.5,
          "do": "camera",
          "target": "foot",
          "fill": 0.8,
          "side": "centre",
          "tilt": "none",
          "over": 1.0
        },
        {
          "at": 11.5,
          "do": "click",
          "target": "share-button",
          "state": "share",
          "over": 0.6
        },
        {
          "at": 11.6,
          "do": "camera",
          "target": "share-popover",
          "fill": 0.5,
          "over": 0.7
        },
        {
          "at": 13.1,
          "do": "camera",
          "target": "brand",
          "fill": 0.3,
          "over": 1.2
        },
        {
          "at": 13.3,
          "do": "veil",
          "target": "brand",
          "over": 0.7
        },
        {
          "at": 14.2,
          "do": "say",
          "text": "Ask your revenue.",
          "place": "under",
          "size": "title"
        },
        {
          "at": 14.45,
          "do": "say",
          "text": "lumen.example",
          "place": "foot",
          "size": "text"
        }
      ]
    }
  ],
  "audio": [
    {
      "id": "sfx",
      "src": "assets/ui-sfx-dark.m4a",
      "origin": "placeholder",
      "role": "sfx",
      "volume": 0.6
    }
  ]
}
