{
  "project": {
    "title": "Lumen - cinematic product cut",
    "fps": 30,
    "aspectRatio": "16:9",
    "duration": 15.4
  },
  "direction": {
    "concept": "One lit input in a dark room. The question is asked into it, the room fills with the product, and the camera walks round it as it works.",
    "audience": "People who run a subscription business and wait on someone else for every revenue number.",
    "message": "You can ask Lumen a revenue question in plain words and have the answer before the meeting.",
    "tone": "Quiet and confident, closer to a product photograph than a screen recording.",
    "palette": "A black stage lit only by the screen's own cobalt spill; type in warm white.",
    "typography": "Playfair Display twice only: one line before the product is seen, one after. Nothing is written beside the product while it works.",
    "motion": "The product is always the centre of the frame and always an object in space: the camera orbits it on a wide lens, a new angle for each thing it does, and comes upright only for the answer.",
    "pacing": "A slow push through the typing, the reveal on the click, a beat of stillness on the answer, then an orbit that does not stop until the film ends."
  },
  "brand": {
    "name": "Lumen",
    "kind": "example",
    "url": "lumen.example"
  },
  "style": {
    "background": "#07080b",
    "ink": "#f4f2ec",
    "accent": "#4f6bff",
    "displayFont": "Playfair Display",
    "textFont": "Inter",
    "light": "none"
  },
  "screens": {
    "app": {
      "html": "product/index.html",
      "width": 1440,
      "height": 900,
      "origin": "placeholder"
    }
  },
  "scenes": [
    {
      "id": "film",
      "recipe": "product-take",
      "duration": 15.4,
      "screen": "app",
      "purpose": "The whole film is one take: the product is used from question to shared answer, the film's lines sit beside it, and it resolves into its own mark.",
      "params": {
        "from": "ask-bar",
        "fill": 0.5,
        "tilt": "left",
        "lens": "wide",
        "spill": true,
        "maxZoom": 1.6
      },
      "beats": [
        {
          "at": 0.0,
          "do": "veil",
          "target": "ask-bar"
        },
        {
          "at": 0.0,
          "do": "say",
          "text": "Every number used to be a ticket.",
          "place": "over",
          "size": "title",
          "over": 2.8
        },
        {
          "at": 0.2,
          "do": "camera",
          "target": "ask-bar",
          "fill": 0.6,
          "tilt": "up",
          "over": 2.4
        },
        {
          "at": 1.0,
          "do": "cursor",
          "target": "ask-input",
          "over": 0.5
        },
        {
          "at": 1.2,
          "do": "type",
          "target": "ask-input",
          "text": "Which plan grew fastest last quarter?",
          "over": 1.4
        },
        {
          "at": 3.0,
          "do": "click",
          "target": "send",
          "state": "thinking",
          "over": 0.4
        },
        {
          "at": 3.05,
          "do": "veil",
          "target": "window",
          "over": 1.1
        },
        {
          "at": 3.1,
          "do": "camera",
          "target": "window",
          "fill": 0.9,
          "tilt": "none",
          "over": 1.3
        },
        {
          "at": 4.4,
          "do": "state",
          "state": "arriving"
        },
        {
          "at": 4.4,
          "do": "reveal",
          "target": "answer",
          "over": 1.0
        },
        {
          "at": 4.7,
          "do": "draw",
          "target": "plot",
          "over": 1.0
        },
        {
          "at": 4.9,
          "do": "count",
          "target": "team-value",
          "over": 0.9
        },
        {
          "at": 6.2,
          "do": "camera",
          "target": "answer",
          "fill": 0.62,
          "tilt": "right",
          "over": 1.4
        },
        {
          "at": 6.9,
          "do": "cursor",
          "target": "bar-team",
          "over": 0.6
        },
        {
          "at": 7.1,
          "do": "highlight",
          "target": "bar-team",
          "over": 1.4
        },
        {
          "at": 8.6,
          "do": "camera",
          "target": "foot",
          "fill": 0.66,
          "tilt": "left",
          "over": 1.2
        },
        {
          "at": 9.6,
          "do": "click",
          "target": "share-button",
          "state": "share",
          "over": 0.6
        },
        {
          "at": 9.7,
          "do": "camera",
          "target": "share-popover",
          "fill": 0.42,
          "tilt": "none",
          "over": 0.9
        },
        {
          "at": 11.2,
          "do": "camera",
          "target": "window",
          "fill": 0.62,
          "tilt": "up",
          "level": "high",
          "over": 1.6
        },
        {
          "at": 12.0,
          "do": "say",
          "text": "Ask your revenue.\nlumen.example",
          "place": "foot",
          "size": "title"
        },
        {
          "at": 12.8,
          "do": "camera",
          "target": "window",
          "fill": 0.66,
          "tilt": "left",
          "level": "high",
          "over": 2.4
        }
      ]
    }
  ],
  "audio": [
    {
      "id": "sfx",
      "src": "assets/ui-sfx-dark.m4a",
      "origin": "placeholder",
      "role": "sfx",
      "volume": 0.6
    }
  ]
}
