  "scenes": [
    {
      "id": "hook",
      "recipe": "product-shot",
      "duration": 2.4,
      "purpose": "Open inside the product, on the question the whole film is about, as it is typed.",
      "screen": "home",
      "text": {
        "typeText": "Which plan grew fastest last quarter?"
      },
      "params": {
        "isolate": "ask-bar",
        "radius": 18,
        "from": "ask-bar",
        "typeIn": "ask-input",
        "fill": 0.78
      }
    },
    {
      "id": "meet",
      "recipe": "statement",
      "duration": 1.2,
      "purpose": "Name the product the viewer has just watched being used.",
      "text": {
        "line1": "Meet Lumen.",
        "emphasis": "Lumen."
      },
      "params": {
        "size": "display"
      }
    },
    {
      "id": "reveal",
      "recipe": "product-shot",
      "duration": 1.7,
      "purpose": "Show the whole product for the first time, and send the question.",
      "screen": "asked",
      "params": {
        "from": "window",
        "enter": "rise",
        "cursor": "send",
        "clickAt": 0.7
      }
    },
    {
      "id": "answer",
      "recipe": "product-shot",
      "duration": 1.7,
      "purpose": "The product answers in one sentence: this is the value of the product.",
      "screen": "answer",
      "text": {
        "label": "An answer, not a dashboard",
        "emphasis": "answer"
      },
      "params": {
        "isolate": "answer",
        "radius": 20,
        "from": "answer",
        "fill": 0.64,
        "labelAt": "bottom-center"
      }
    },
    {
      "id": "proof",
      "recipe": "product-shot",
      "duration": 1.3,
      "purpose": "Push in to the row the answer rests on, so the claim is seen in the product itself.",
      "screen": "answer",
      "text": {},
      "params": {
        "isolate": "answer",
        "radius": 20,
        "from": "answer",
        "to": "bar-team",
        "highlight": "bar-team",
        "fill": 0.86,
        "move": "settle"
      }
    },
    {
      "id": "share",
      "recipe": "product-shot",
      "duration": 1.1,
      "purpose": "The next step a team takes: pass the answer on.",
      "screen": "answer",
      "params": {
        "isolate": "answer",
        "radius": 20,
        "from": "foot",
        "fill": 0.72,
        "cursor": "share-button",
        "clickAt": 0.6
      }
    },
    {
      "id": "shared",
      "recipe": "product-shot",
      "duration": 1.3,
      "purpose": "The click worked: the answer is now a link the team can open.",
      "screen": "share",
      "text": {},
      "params": {
        "isolate": "share-popover",
        "radius": 14,
        "from": "share-popover",
        "fill": 0.42
      }
    },
    {
      "id": "benefit",
      "recipe": "statement",
      "duration": 1.7,
      "purpose": "Say what that sequence means for the viewer’s Monday.",
      "text": {
        "line1": "The answer,",
        "line2": "before the meeting starts.",
        "emphasis": "before"
      }
    },
    {
      "id": "close",
      "recipe": "brand-close",
      "duration": 2.6,
      "purpose": "Leave the name, what it does, and where to find it.",
      "assets": {
        "mark": {
          "src": "assets/lumen-mark.svg",
          "origin": "placeholder"
        }
      },
      "text": {
        "name": "Lumen",
        "tagline": "Ask your revenue.",
        "cta": "lumen.example"
      }
    }
  ],
  "audio": [
    {
      "id": "sfx",
      "src": "assets/ui-sfx.m4a",
      "origin": "placeholder",
      "volume": 0.9
    }
  ]
}
