{
  "project": {
    "title": "Lumen - 17 second product showcase",
    "fps": 30,
    "aspectRatio": "16:9",
    "duration": 17.0
  },
  "direction": {
    "concept": "A revenue question that used to be a ticket is asked and answered inside the product, start to finish.",
    "audience": "People who run a subscription business and wait on someone else for every revenue number.",
    "message": "You can ask Lumen a revenue question in plain words and have the answer before the meeting.",
    "tone": "Calm and exact, like a tool that already works; nothing is sold harder than it is shown.",
    "palette": "A near-black stage with one cobalt glow and one warm glow, the product's white interface as the only bright surface, and cobalt as the single accent.",
    "typography": "Inter throughout, the product’s own face; copy is small, sentence case, one line at a time.",
    "motion": "One camera move per shot on the real interface, turned in perspective with a shallow focus on wide shots; cursor and typing are the only other things that move.",
    "pacing": "Ten shots in seventeen seconds, cut on action; the film opens on the clutter, and slows only for the benefit line and the close."
  },
  "brand": {
    "name": "Lumen",
    "kind": "example",
    "url": "lumen.example"
  },
  "style": {
    "background": "#07080d",
    "ink": "#f2f2ee",
    "accent": "#4f6bff",
    "glow": "#ff6a3d",
    "displayFont": "Inter",
    "textFont": "Inter",
    "light": "aurora"
  },
