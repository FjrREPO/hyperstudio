{
  "project": {
    "title": "Lumen - 30 second launch film",
    "fps": 30,
    "aspectRatio": "16:9",
    "duration": 29.6
  },
  "direction": {
    "concept": "A revenue question, twice: once the old way, in an export and a thread that goes quiet, and once asked of the product, which answers and keeps answering.",
    "audience": "People who run a subscription business and wait on someone else for every revenue number.",
    "message": "You can ask Lumen a revenue question in plain words and have the answer before the meeting.",
    "tone": "Composed and unhurried, like a well-set page; the type states, the product proves.",
    "palette": "A pale stone stage, ink for type, white interfaces, and cobalt only where the product itself uses it.",
    "typography": "Playfair Display at two scales, a very large headline and a small caption, never in the same place twice; the interfaces keep their own Inter.",
    "motion": "The camera is flat and frontal and follows the cursor; the page is recomposed as the story moves, and the product is first seen through the one thing you do with it, its question bar.",
    "pacing": "Eight seconds of the old way ending on a message nobody answers; a cut; then one unbroken take in which the product is asked, answers, is filed, is asked again, and closes down to its mark."
  },
  "brand": {
    "name": "Lumen",
    "kind": "example",
    "url": "lumen.example"
  },
  "style": {
    "background": "#efede8",
    "ink": "#14130f",
    "accent": "#3b5bff",
    "displayFont": "Playfair Display",
    "textFont": "Inter",
    "light": "none"
  },
  "screens": {
    "app": {
      "html": "product/index.html",
      "width": 1440,
      "height": 900,
      "origin": "placeholder"
    },
    "before": {
      "html": "product/before.html",
      "width": 1440,
      "height": 900,
      "origin": "placeholder"
    }
  },
