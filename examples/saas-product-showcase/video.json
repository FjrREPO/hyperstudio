  "scenes": [
    {
      "id": "problem",
      "recipe": "scatter",
      "duration": 2.6,
      "purpose": "Open on what the viewer lives with: a simple revenue question scattered across messages, files and waiting.",
      "text": {
        "note1": "Which plan grew fastest last quarter?",
        "note2": "Asked in #finance, 3 days ago",
        "note3": "q3_export_final_v7.csv",
        "note4": "Can you pull this before Monday?",
        "note5": "Still waiting on the numbers",
        "line": "Every number is a ticket."
      }
    },
    {
      "id": "hook",
      "recipe": "product-shot",
      "duration": 1.8,
      "purpose": "The same question, now typed into the product instead of sent to a person.",
      "screen": "home",
      "text": {
        "typeText": "Which plan grew fastest last quarter?"
      },
      "params": {
        "isolate": "ask-bar",
        "radius": 20,
        "from": "ask-bar",
        "typeIn": "ask-input",
        "fill": 0.74,
        "tilt": "up"
      }
    },
    {
      "id": "meet",
      "recipe": "statement",
      "duration": 1.2,
      "purpose": "Name the product the viewer has just watched being used.",
      "text": {
        "line1": "Meet Lumen.",
        "emphasis": "Lumen."
      },
      "params": {
        "size": "display"
      }
    },
    {
      "id": "reveal",
      "recipe": "product-shot",
      "duration": 1.8,
      "purpose": "Show the whole product for the first time, and send the question.",
      "screen": "asked",
      "params": {
        "from": "window",
        "to": "ask-bar",
        "fill": 0.92,
        "move": "ease",
        "tilt": "left",
        "focus": "centre",
        "cursor": "send",
        "clickAt": 0.72
      }
    },
    {
      "id": "answer",
      "recipe": "product-shot",
      "duration": 1.6,
      "purpose": "The product answers in one sentence with the chart behind it: this is the value of the product.",
      "screen": "answer",
      "text": {
        "label": "An answer, not a dashboard",
        "emphasis": "answer"
      },
      "params": {
        "isolate": "answer",
        "radius": 22,
        "from": "answer",
        "fill": 0.7,
        "labelAt": "bottom-center"
      }
    },
    {
      "id": "proof",
      "recipe": "product-shot",
      "duration": 1.4,
      "purpose": "Push in to the row the answer rests on, so the claim is seen in the product itself.",
      "screen": "answer",
      "params": {
        "isolate": "answer",
        "radius": 22,
        "from": "chart",
        "to": "bar-team",
        "highlight": "bar-team",
        "fill": 0.62,
        "move": "settle",
        "tilt": "right"
      }
    },
    {
      "id": "share",
      "recipe": "product-shot",
      "duration": 1.2,
      "purpose": "The next step a team takes: pass the answer on.",
      "screen": "answer",
      "params": {
        "from": "answer",
        "to": "actions",
        "fill": 0.56,
        "move": "ease",
        "cursor": "share-button",
        "clickAt": 0.66
      }
    },
    {
      "id": "shared",
      "recipe": "product-shot",
      "duration": 1.1,
      "purpose": "The click worked: the answer is now a link the team can open.",
      "screen": "share",
      "params": {
        "isolate": "answer",
        "radius": 22,
        "from": "share-popover",
        "fill": 0.5,
        "tilt": "up"
      }
    },
    {
      "id": "benefit",
      "recipe": "statement",
      "duration": 1.7,
      "purpose": "Say what that sequence means for the viewer’s Monday.",
      "text": {
        "line1": "The answer,",
        "line2": "before the meeting starts.",
        "emphasis": "before"
      }
    },
    {
      "id": "close",
      "recipe": "brand-close",
      "duration": 2.6,
      "purpose": "Leave the name, what it does, and where to find it.",
      "assets": {
        "mark": {
          "src": "assets/lumen-mark.svg",
          "origin": "placeholder"
        }
      },
      "text": {
        "name": "Lumen",
        "tagline": "Ask your revenue.",
        "cta": "lumen.example"
      }
    }
  ],
