{
  "project": {
    "title": "Lumen - editorial cut",
    "fps": 30,
    "aspectRatio": "16:9",
    "duration": 14.8
  },
  "direction": {
    "concept": "A magazine spread that happens to be alive: large type on the left, the product working on the right, one unbroken take.",
    "audience": "People who run a subscription business and wait on someone else for every revenue number.",
    "message": "You can ask Lumen a revenue question in plain words and have the answer before the meeting.",
    "tone": "Composed and unhurried, like a well-set page; the type states, the product proves.",
    "palette": "A pale stone stage, ink for type, the product's white interface, and cobalt only where the product itself uses it.",
    "typography": "Playfair Display at headline size, flush left on the margin, two lines at most; the interface keeps its own Inter.",
    "motion": "The frame is split and stays split: type holds still on the left while the camera follows the cursor on the right, flat and frontal.",
    "pacing": "A fast first second, time to read the answer when it lands, and a slow last move as the product resolves into its mark."
  },
  "brand": {
    "name": "Lumen",
    "kind": "example",
    "url": "lumen.example"
  },
  "style": {
    "background": "#eceae4",
    "ink": "#14130f",
    "accent": "#3b5bff",
    "displayFont": "Playfair Display",
    "textFont": "Inter",
    "light": "none"
  },
  "screens": {
    "app": {
      "html": "product/index.html",
      "width": 1440,
      "height": 900,
      "origin": "placeholder"
    }
  },
  "scenes": [
    {
      "id": "film",
      "recipe": "product-take",
      "duration": 14.8,
      "screen": "app",
      "purpose": "The whole film is one take: the product is used from question to shared answer, the film's lines sit beside it, and it resolves into its own mark.",
      "params": {
        "from": "window",
        "fill": 0.84,
        "side": "right",
        "maxZoom": 5
      },
      "beats": [
        {
          "at": 0.0,
          "do": "say",
          "text": "Ask your\nrevenue.",
          "place": "left",
          "size": "hero"
        },
        {
          "at": 0.5,
          "do": "camera",
          "target": "ask-bar",
          "fill": 0.92,
          "over": 1.1
        },
        {
          "at": 1.1,
          "do": "cursor",
          "target": "ask-input",
          "over": 0.5
        },
        {
          "at": 1.3,
          "do": "type",
          "target": "ask-input",
          "text": "Which plan grew fastest last quarter?",
          "over": 1.4
        },
        {
          "at": 3.0,
          "do": "click",
          "target": "send",
          "state": "thinking",
          "over": 0.4
        },
        {
          "at": 3.1,
          "do": "say",
          "text": "No ticket.\nNo waiting.",
          "place": "left",
          "size": "hero"
        },
        {
          "at": 3.1,
          "do": "camera",
          "target": "answer",
          "fill": 0.86,
          "over": 0.9
        },
        {
          "at": 4.2,
          "do": "state",
          "state": "arriving"
        },
        {
          "at": 4.2,
          "do": "reveal",
          "target": "answer",
          "over": 1.0
        },
        {
          "at": 4.5,
          "do": "draw",
          "target": "plot",
          "over": 1.0
        },
        {
          "at": 4.7,
          "do": "count",
          "target": "team-value",
          "over": 0.9
        },
        {
          "at": 6.2,
          "do": "say",
          "text": "An answer,\nnot a\ndashboard.",
          "place": "left",
          "size": "hero"
        },
        {
          "at": 6.3,
          "do": "camera",
          "target": "chart",
          "fill": 0.9,
          "over": 1.0
        },
        {
          "at": 6.7,
          "do": "cursor",
          "target": "bar-team",
          "over": 0.6
        },
        {
          "at": 6.9,
          "do": "highlight",
          "target": "bar-team",
          "over": 1.4
        },
        {
          "at": 8.4,
          "do": "camera",
          "target": "foot",
          "fill": 0.9,
          "over": 0.8
        },
        {
          "at": 9.2,
          "do": "click",
          "target": "share-button",
          "state": "share",
          "over": 0.6
        },
        {
          "at": 9.3,
          "do": "say",
          "text": "Shared\nin a click.",
          "place": "left",
          "size": "hero",
          "over": 1.9
        },
        {
          "at": 9.4,
          "do": "camera",
          "target": "share-popover",
          "fill": 0.74,
          "over": 0.7
        },
        {
          "at": 11.2,
          "do": "camera",
          "target": "brand",
          "fill": 0.3,
          "side": "centre",
          "over": 1.2
        },
        {
          "at": 11.4,
          "do": "veil",
          "target": "brand",
          "over": 0.7
        },
        {
          "at": 12.3,
          "do": "say",
          "text": "Ask your revenue.",
          "place": "under",
          "size": "title"
        },
        {
          "at": 12.55,
          "do": "say",
          "text": "lumen.example",
          "place": "foot",
          "size": "text"
        }
      ]
    }
  ],
  "audio": [
    {
      "id": "sfx",
      "src": "assets/ui-sfx.m4a",
      "origin": "placeholder",
      "role": "sfx",
      "volume": 0.6
    }
  ]
}
