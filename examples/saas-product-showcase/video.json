{
  "project": {
    "title": "Lumen - 14.7 second product film",
    "fps": 30,
    "aspectRatio": "16:9",
    "duration": 14.7
  },
  "direction": {
    "concept": "The film is one question asked and answered inside the product, in a single unbroken take.",
    "audience": "People who run a subscription business and wait on someone else for every revenue number.",
    "message": "You can ask Lumen a revenue question in plain words and have the answer before the meeting.",
    "tone": "Plain and exact, like a screen recording made by someone with taste; the product does the talking.",
    "palette": "A cool grey stage with nothing on it, the product's white interface, ink for type, and cobalt only where the product itself uses it.",
    "typography": "Inter throughout, set left on the film's margin; copy is small and never centred over the product.",
    "motion": "The camera follows the cursor through the interface and never cuts while an action is in progress; nothing moves that the user did not cause.",
    "pacing": "One long take carries the film; type holds are short and the only cuts fall before and after the product."
  },
  "brand": {
    "name": "Lumen",
    "kind": "example",
    "url": "lumen.example"
  },
  "style": {
    "background": "#e9ebf0",
    "ink": "#0d0e12",
    "accent": "#3b5bff",
    "displayFont": "Inter",
    "textFont": "Inter",
    "light": "none"
  },
  "screens": {
    "app": {
      "html": "product/index.html",
      "width": 1440,
      "height": 900,
      "origin": "placeholder"
    }
  },
  "scenes": [
    {
      "id": "open",
      "recipe": "statement",
      "duration": 1.2,
      "purpose": "Say what the product is for in three words, before it is seen.",
      "text": {
        "line1": "Ask your revenue."
      },
      "params": {
        "size": "display",
        "align": "left"
      }
    },
    {
      "id": "ask",
      "recipe": "product-take",
      "duration": 9.2,
      "screen": "app",
      "purpose": "One unbroken take: the question is typed and sent, the product reads the billing data, the answer arrives with its chart, and it is shared in a click.",
      "params": {
        "from": "window",
        "fill": 0.9
      },
      "beats": [
        {
          "at": 0.1,
          "do": "camera",
          "target": "ask-bar",
          "fill": 0.6,
          "over": 1.2
        },
        {
          "at": 0.6,
          "do": "cursor",
          "target": "ask-input",
          "over": 0.5
        },
        {
          "at": 0.8,
          "do": "type",
          "target": "ask-input",
          "text": "Which plan grew fastest last quarter?",
          "over": 1.5
        },
        {
          "at": 2.6,
          "do": "click",
          "target": "send",
          "state": "thinking",
          "over": 0.4
        },
        {
          "at": 2.7,
          "do": "camera",
          "target": "thinking",
          "fill": 0.74,
          "over": 0.8
        },
        {
          "at": 3.6,
          "do": "state",
          "state": "answer"
        },
        {
          "at": 3.6,
          "do": "reveal",
          "target": "answer",
          "over": 1.0
        },
        {
          "at": 3.7,
          "do": "camera",
          "target": "answer",
          "fill": 0.8,
          "over": 0.9
        },
        {
          "at": 4.0,
          "do": "draw",
          "target": "plot",
          "over": 1.0
        },
        {
          "at": 5.1,
          "do": "camera",
          "target": "bar-team",
          "fill": 0.46,
          "over": 0.9
        },
        {
          "at": 5.3,
          "do": "cursor",
          "target": "bar-team",
          "over": 0.6
        },
        {
          "at": 5.4,
          "do": "highlight",
          "target": "bar-team",
          "over": 1.0
        },
        {
          "at": 6.4,
          "do": "camera",
          "target": "foot",
          "fill": 0.7,
          "over": 0.8
        },
        {
          "at": 7.2,
          "do": "click",
          "target": "share-button",
          "state": "share",
          "over": 0.7
        },
        {
          "at": 7.3,
          "do": "camera",
          "target": "share-popover",
          "fill": 0.42,
          "over": 0.7
        },
        {
          "at": 8.3,
          "do": "camera",
          "target": "answer",
          "fill": 0.78,
          "over": 0.9
        }
      ]
    },
    {
      "id": "benefit",
      "recipe": "statement",
      "duration": 1.7,
      "purpose": "Say what that sequence means for the viewer’s Monday.",
      "text": {
        "line1": "The answer,",
        "line2": "before the meeting starts.",
        "emphasis": "before"
      },
      "params": {
        "align": "left"
      }
    },
    {
      "id": "close",
      "recipe": "brand-close",
      "duration": 2.6,
      "purpose": "Leave the name, what it does, and where to find it.",
      "assets": {
        "mark": {
          "src": "assets/lumen-mark-dark.svg",
          "origin": "placeholder"
        }
      },
      "text": {
        "name": "Lumen",
        "tagline": "Ask your revenue.",
        "cta": "lumen.example"
      }
    }
  ],
  "audio": [
    {
      "id": "sfx",
      "src": "assets/ui-sfx.m4a",
      "origin": "placeholder",
      "role": "sfx",
      "volume": 0.6
    }
  ]
}
