        "window": [0, 0, 1440, 900],
        "connected": [1259, 16, 149, 28],
        "question": [872, 104, 344, 48],
        "answer": [456, 178, 760, 364],
        "answer-line": [489, 241, 694, 36],
        "chart": [489, 331, 694, 106],
        "bar-team": [489, 371, 694, 26],
        "team-value": [1127, 375, 56, 19],
        "foot": [489, 461, 694, 56],
