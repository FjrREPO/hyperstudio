        "greeting": [456, 210, 760, 49],
        "ask-bar": [456, 324, 760, 68],
        "ask-input": [481, 345, 664, 26],
        "send": [1159, 336, 44, 44]
      }
    },
    "answer": {
      "src": "screens/answer.png",
      "width": 1440,
