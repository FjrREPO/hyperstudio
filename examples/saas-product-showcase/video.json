{
  "project": {
    "title": "Lumen - 15 second product showcase",
    "fps": 30,
    "aspectRatio": "16:9",
    "duration": 15
  },
  "direction": {
    "concept": "The film is one question being asked and answered inside the product, start to finish.",
    "audience": "People who run a subscription business and wait on someone else for every revenue number.",
    "message": "You can ask Lumen a revenue question in plain words and have the answer before the meeting.",
    "tone": "Calm and exact, like a tool that already works; nothing is sold harder than it is shown.",
    "palette": "Warm paper stage, near-black ink, and one cobalt accent used only where the eye should land.",
    "typography": "Inter throughout, the product’s own face; copy is small, sentence case, one line at a time.",
    "motion": "One camera move per shot on the real interface; cursor and typing are the only other things that move.",
    "pacing": "Nine shots in fifteen seconds, cut on action; the film slows only for the benefit line and the close."
  },
  "brand": {
    "name": "Lumen",
    "kind": "example",
    "url": "lumen.example"
  },
  "style": {
    "background": "#f3efe6",
    "ink": "#17150f",
    "accent": "#2747f0",
    "displayFont": "Inter",
    "textFont": "Inter",
    "light": "soft"
  },
  "screens": {
    "home": {
      "src": "screens/home.png",
      "width": 1440,
      "height": 900,
      "origin": "placeholder",
      "regions": {
        "window": [0, 0, 1440, 900],
