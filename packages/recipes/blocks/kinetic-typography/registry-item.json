{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "kinetic-typography",
  "type": "hyperframes:block",
  "title": "Kinetic Typography",
  "description": "Text is the picture: up to four short lines, sized to fill the canvas and choreographed word by word, with one phrase picked out in the accent colour. Stack builds the lines into one block; sequence shows one line at a time. Use it for a hook, a manifesto, a claim or a closing line. No assets needed.",
  "tags": ["cinematic", "typography", "kinetic", "text", "hook"],
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 5,
  "hyperstudio": {
    "minDuration": 2,
    "maxDuration": 12,
    "required": ["line1"]
  },
  "files": [
    {
      "path": "kinetic-typography.html",
      "target": "compositions/kinetic-typography.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "line1",
      "type": "string",
      "role": "content",
      "label": "Line 1",
      "description": "Keep each line under about 24 characters; it is never wrapped, only scaled down.",
      "default": "Make it move."
    },
    {
      "id": "line2",
      "type": "string",
      "role": "content",
      "label": "Line 2",
      "description": "Empty lines are skipped.",
      "default": ""
    },
    {
      "id": "line3",
      "type": "string",
      "role": "content",
      "label": "Line 3",
      "default": ""
    },
    {
      "id": "line4",
      "type": "string",
      "role": "content",
      "label": "Line 4",
      "default": ""
    },
    {
      "id": "emphasis",
      "type": "string",
      "role": "content",
      "label": "Emphasised phrase",
      "description": "A word or phrase that appears in the lines; it is set in the accent colour. Empty for none.",
      "default": ""
    },
    {
      "id": "mode",
      "type": "enum",
      "role": "layout",
      "label": "Mode",
      "default": "stack",
      "options": [
        {
          "value": "stack",
          "label": "Stack: lines build into one block and stay"
        },
        {
          "value": "sequence",
          "label": "Sequence: one line at a time, as large as it fits"
        }
      ]
    },
    {
      "id": "motion",
      "type": "enum",
      "role": "motion",
      "label": "Entrance",
      "default": "rise",
      "options": [
        {
          "value": "rise",
          "label": "Rise: words lift out of a mask"
        },
        {
          "value": "slam",
          "label": "Slam: words punch in from large"
        },
        {
          "value": "blur",
          "label": "Blur: words resolve out of soft focus"
        }
      ]
    },
    {
      "id": "align",
      "type": "enum",
      "role": "layout",
      "label": "Alignment",
      "description": "Portrait canvases are always centered.",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Centered"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ]
    },
    {
      "id": "textCase",
      "type": "enum",
      "role": "look",
      "label": "Case",
      "default": "upper",
      "options": [
        {
          "value": "upper",
          "label": "UPPERCASE"
        },
        {
          "value": "none",
          "label": "As typed"
        }
      ]
    },
    {
      "id": "backdrop",
      "type": "enum",
      "role": "look",
      "label": "Backdrop",
      "default": "glow",
      "options": [
        {
          "value": "plain",
          "label": "Flat colour"
        },
        {
          "value": "glow",
          "label": "Slow accent glow"
        },
        {
          "value": "grid",
          "label": "Grid with a faint glow"
        }
      ]
    },
    {
      "id": "exit",
      "type": "enum",
      "role": "motion",
      "label": "Exit",
      "description": "hold keeps the final frame for a cut or a transition; fade clears the frame at the end.",
      "default": "hold",
      "options": [
        {
          "value": "hold",
          "label": "Hold"
        },
        {
          "value": "fade",
          "label": "Fade out"
        }
      ]
    },
    {
      "id": "accent",
      "type": "color",
      "role": "brand",
      "label": "Accent colour",
      "default": "#ff5a36"
    },
    {
      "id": "background",
      "type": "color",
      "role": "brand",
      "label": "Background",
      "default": "#0b0b0f"
    },
    {
      "id": "ink",
      "type": "color",
      "role": "brand",
      "label": "Text colour",
      "default": "#f6f4ee"
    },
    {
      "id": "headingFont",
      "type": "enum",
      "role": "brand",
      "label": "Typeface",
      "default": "Inter",
      "options": [
        {
          "value": "Playfair Display",
          "label": "Playfair Display"
        },
        {
          "value": "EB Garamond",
          "label": "EB Garamond"
        },
        {
          "value": "Inter",
          "label": "Inter"
        },
        {
          "value": "Outfit",
          "label": "Outfit"
        },
        {
          "value": "Montserrat",
          "label": "Montserrat"
        },
        {
          "value": "Poppins",
          "label": "Poppins"
        },
        {
          "value": "Oswald",
          "label": "Oswald"
        },
        {
          "value": "Archivo Black",
          "label": "Archivo Black"
        }
      ]
    }
  ]
}
