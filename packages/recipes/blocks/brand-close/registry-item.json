{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "brand-close",
  "type": "hyperframes:block",
  "title": "Brand Close",
  "description": "The ending: the brand's mark arrives, the name opens out beside it, then the tagline and an optional button. Quiet and held.",
  "tags": ["brand", "logo", "ending", "cta"],
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 2.5,
  "hyperstudio": {
    "minDuration": 2,
    "maxDuration": 5,
    "required": ["mark", "name"],
    "screen": false
  },
  "files": [
    {
      "path": "brand-close.html",
      "target": "compositions/brand-close.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    {
      "id": "mark",
      "type": "image",
      "role": "content",
      "label": "Brand mark",
      "description": "The logo mark as SVG or transparent PNG, square.",
      "default": ""
    },
    {
      "id": "name",
      "type": "string",
      "role": "content",
      "label": "Brand name",
      "default": "",
      "maxLength": 18
    },
    {
      "id": "tagline",
      "type": "string",
      "role": "content",
      "label": "Tagline",
      "description": "Empty hides it.",
      "default": "",
      "maxLength": 44
    },
    {
      "id": "cta",
      "type": "string",
      "role": "content",
      "label": "Button",
      "description": "Two or three words. Empty hides it.",
      "default": "",
      "maxLength": 22
    },
    {
      "id": "background",
      "type": "color",
      "role": "brand",
      "label": "Stage background",
      "default": "#f3efe6"
    },
    {
      "id": "ink",
      "type": "color",
      "role": "brand",
      "label": "Text colour",
      "default": "#17150f"
    },
    {
      "id": "accent",
      "type": "color",
      "role": "brand",
      "label": "Accent colour",
      "description": "The film's one accent. Used for emphasis only.",
      "default": "#2747f0"
    },
    {
      "id": "displayFont",
      "type": "enum",
      "role": "brand",
      "label": "Display typeface",
      "default": "Inter",
      "options": [
        {
          "value": "Inter",
          "label": "Inter"
        },
        {
          "value": "Outfit",
          "label": "Outfit"
        },
        {
          "value": "Montserrat",
          "label": "Montserrat"
        },
        {
          "value": "Poppins",
          "label": "Poppins"
        },
        {
          "value": "Playfair Display",
          "label": "Playfair Display"
        },
        {
          "value": "EB Garamond",
          "label": "EB Garamond"
        },
        {
          "value": "Oswald",
          "label": "Oswald"
        },
        {
          "value": "Archivo Black",
          "label": "Archivo Black"
        }
      ]
    },
    {
      "id": "textFont",
      "type": "enum",
      "role": "brand",
      "label": "Text typeface",
      "default": "Inter",
      "options": [
        {
          "value": "Inter",
          "label": "Inter"
        },
        {
          "value": "Outfit",
          "label": "Outfit"
        },
        {
          "value": "Montserrat",
          "label": "Montserrat"
        },
        {
          "value": "Poppins",
          "label": "Poppins"
        },
        {
          "value": "IBM Plex Mono",
          "label": "IBM Plex Mono"
        }
      ]
    }
  ]
}
